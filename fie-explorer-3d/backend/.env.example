# ============================================================
# FIE Explorer 3D — Variables de entorno (.env.example)
# Copiar como .env y rellenar los valores reales
# ============================================================

# ─── Base de Datos ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fie_explorer_3d
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ─── Servidor ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_al_menos_32_caracteres_aleatorios
JWT_EXPIRES_IN=8h

# ─── CORS — URLs de los dos frontends ────────────────────────
ADMIN_FRONTEND_URL=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5174

# ─── Rate Limit ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Cifrado pgcrypto ────────────────────────────────────────
# Clave para pgp_sym_encrypt (pgcrypto). Cambiar en producción.
DB_ENCRYPTION_KEY=fie_secret_key_2026_AES256
