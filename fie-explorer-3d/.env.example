# ================================================================
#  FIE Explorer 3D — Variables de entorno
#  INSTRUCCIONES:
#    1. Copiar este archivo: cp .env.example .env
#    2. Completar los valores marcados con TODO
#    3. NUNCA subir el archivo .env al repositorio
# ================================================================

# ── Entorno ───────────────────────────────────────────────────
# Valores válidos: development | production
NODE_ENV=development

# ── Base de datos PostgreSQL + PostGIS ────────────────────────
POSTGRES_DB=fie_explorer_3d
POSTGRES_USER=fie_user
# TODO: Cambiar por una contraseña segura en producción
POSTGRES_PASSWORD=fie_secret
# Puerto expuesto en el host (el contenedor siempre usa 5432)
POSTGRES_PORT=5432

# ── Backend (Node.js / Express) ───────────────────────────────
BACKEND_PORT=4000

# JWT — Clave secreta para firmar tokens de administrador
# TODO: Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo 32 caracteres. NUNCA usar este valor en producción.
JWT_SECRET=change_this_in_production_min_32chars_abc123xyz

# Tiempo de expiración de sesión de administrador
# Formato: 8h | 1d | 30m
JWT_EXPIRES_IN=8h

# URL del frontend para la política CORS del backend
FRONTEND_URL=http://localhost:5173

# ── Frontend (React / Vite) ───────────────────────────────────
FRONTEND_PORT=5173

# URL base de la API REST consumida por el frontend
VITE_API_URL=http://localhost:4000/api

# Nombre de la aplicación (mostrado en la interfaz)
VITE_APP_NAME=FIE Explorer 3D

# ── Producción (completar solo al desplegar) ──────────────────
# DOMAIN=fie-explorer.espoch.edu.ec
# SSL_CERT_PATH=/etc/letsencrypt/live/fie-explorer.espoch.edu.ec/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/fie-explorer.espoch.edu.ec/privkey.pem
